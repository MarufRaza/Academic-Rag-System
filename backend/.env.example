# ========================================================
# ACADEMIC QUESTION ANSWERING SYSTEM USING RAG - CONFIG
# ========================================================

# LLM Provider: "openai", "gemini", or "ollama"
LLM_PROVIDER=gemini

# OpenAI Configuration (Required when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (Required when LLM_PROVIDER=gemini)
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Ollama Configuration (Required when LLM_PROVIDER=ollama)
# 1. Install Ollama: https://ollama.ai
# 2. Run: ollama serve
# 3. Pull model: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Provider: "huggingface" (Default, runs locally on CPU, free) or "openai"
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG Pipeline Tuning Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
SCORE_THRESHOLD=0.30
MAX_FILE_SIZE_MB=25

# Optional Custom Directories
# UPLOAD_DIR=uploads
# CHROMA_PERSIST_DIR=chroma_db
